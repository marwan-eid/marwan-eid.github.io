---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="container-page grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="font-mono text-sm text-accent">HTTP 404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">This route has no <span class="serif-accent text-accent">upstream.</span></h1>
      <p class="mx-auto mt-4 max-w-md text-muted">
        The page you're looking for doesn't exist or has moved. Try the command menu (<span class="kbd">Ctrl K</span>) or head back home.
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn btn-primary">Home <Icon name="arrow-right" size={16} /></a>
        <a href="/work" class="btn btn-ghost">Case studies</a>
      </div>
    </div>
  </section>
</Base>
