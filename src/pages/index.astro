---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WorkCard from '../components/WorkCard.astro';
import LiveFleet from '../components/LiveFleet.tsx';
import { profile, impact, honors } from '../data/profile';
import avatar from '../assets/avatar.jpg';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [lead, ...rest] = work;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: 'Valeo' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'The American University in Cairo' },
  address: { '@type': 'PostalAddress', addressLocality: 'Giza', addressCountry: 'EG' },
  email: `mailto:${profile.email}`,
  url: profile.site,
  sameAs: [profile.links.github, profile.links.linkedin],
  knowsAbout: ['Distributed systems', 'Event-driven architecture', 'AWS', 'Kubernetes', 'Java', 'Go', 'React'],
};
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-line">
    <div class="bg-grid absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top,black_20%,transparent_70%)]" aria-hidden="true"></div>
    <div
      class="absolute -top-40 left-1/2 -z-10 h-[32rem] w-[60rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,var(--glow),transparent)]"
      aria-hidden="true"
    >
    </div>

    <div class="container-page grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:py-24">
      <div>
        <div class="flex items-center gap-3">
          <Image src={avatar} alt="" width={40} height={40} class="size-10 rounded-full ring-1 ring-line-strong" loading="eager" />
          <div class="leading-tight">
            <p class="text-sm font-medium">{profile.name}</p>
            <p class="text-[0.8rem] text-faint">Software Engineer at Valeo</p>
          </div>
        </div>

        <h1 class="mt-8 text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.035em] text-balance sm:text-6xl lg:text-[4.1rem]">
          I build <span class="whitespace-nowrap">real-time</span> backends that <span class="serif-accent text-accent">hold&nbsp;up.</span>
        </h1>

        <p class="mt-6 max-w-xl text-[1.075rem] leading-relaxed text-muted">
          I design the cloud platform behind live vehicle communication at Valeo, and I work across the stack, from event-driven
          services on AWS and Kubernetes to React frontends. I like making slow systems fast: <span class="text-fg">10 s → 1 s</span>{" "}
          APIs, and deploys from <span class="text-fg">hours to minutes</span>.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/work" class="btn btn-primary">
            See my work
            <Icon name="arrow-right" size={16} />
          </a>
          <a href="/resume" class="btn btn-ghost">
            <Icon name="file" size={16} />
            Resume
          </a>
          <div class="ml-1 flex items-center gap-1">
            <a href={profile.links.github} class="grid size-10 place-items-center rounded-lg text-muted hover:bg-elev hover:text-fg" aria-label="GitHub"
              ><Icon name="github" size={18} /></a
            >
            <a href={profile.links.linkedin} class="grid size-10 place-items-center rounded-lg text-muted hover:bg-elev hover:text-fg" aria-label="LinkedIn"
              ><Icon name="linkedin" size={18} /></a
            >
            <a href={`mailto:${profile.email}`} class="grid size-10 place-items-center rounded-lg text-muted hover:bg-elev hover:text-fg" aria-label="Email"
              ><Icon name="mail" size={18} /></a
            >
          </div>
        </div>

        <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-[0.8rem] text-muted">
          <span class="size-1.5 rounded-full bg-live" aria-hidden="true"></span>
          Open to freelance projects · <a href="/hire" class="link">how I can help</a>
        </p>
      </div>

      <div>
        <LiveFleet client:load api={profile.links.milkrunDemo.replace(/\/$/, '')} replayUrl="/data/milkrun-replay.json" />
        <p class="mt-3 text-[0.82rem] leading-relaxed text-faint">
          <span class="text-muted">Not a mockup.</span> This is <a class="link" href="/work/milkrun">MilkRun</a>, my fleet-tracking pipeline, streaming
          from Kafka through Spring WebFlux to your browser.
        </p>
      </div>
    </div>
  </section>

  <!-- Impact -->
  <section class="border-b border-line">
    <div class="container-page grid grid-cols-2 lg:grid-cols-4">
      {
        impact.map((m, i) => (
          <div
            class:list={[
              'py-7 pr-4 sm:py-9',
              i % 2 === 1 ? 'pl-4 sm:pl-6' : '',
              i % 2 === 0 ? 'border-r border-line' : '',
              i < 2 ? 'border-b border-line lg:border-b-0' : '',
              i === 1 ? 'lg:border-r lg:border-line' : '',
              i === 2 ? 'lg:pl-6' : '',
              i === 3 ? 'lg:pl-6' : '',
            ]}
          >
            <p class="font-mono text-[1.08rem] font-medium tracking-tight whitespace-nowrap text-fg sm:text-2xl">{m.value}</p>
            <p class="mt-1.5 text-sm font-medium">{m.label}</p>
            <p class="mt-1 text-[0.8rem] leading-snug text-faint">{m.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected work -->
  <section class="container-page pt-20 sm:pt-24">
    <SectionHeader eyebrow="Selected work" title="Case studies, written like design docs" link={{ href: '/work', label: 'All work' }} />
    <div class="grid gap-4 md:grid-cols-2">
      <WorkCard entry={lead} size="lg" live />
      {rest.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>

  <!-- Background -->
  <section class="container-page pt-20 sm:pt-24">
    <SectionHeader eyebrow="Background" title="Engineer, with a mathematician's habits" link={{ href: '/about', label: 'More about me' }} />
    <div class="grid gap-4 md:grid-cols-3">
      {
        honors.map((h, i) => (
          <div class="card p-5 sm:p-6">
            <p class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 font-semibold tracking-tight">{h.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{h.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Freelance CTA -->
  <section class="container-page pt-20 sm:pt-24">
    <div class="card relative isolate overflow-hidden p-7 sm:p-10">
      <div class="bg-grid absolute inset-0 -z-10 opacity-70 [mask-image:linear-gradient(to_left,black,transparent_70%)]" aria-hidden="true"></div>
      <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="eyebrow">Freelance</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
            Need a backend that's fast, reliable, and <span class="serif-accent text-accent">boring to operate?</span>
          </h2>
          <p class="mt-3 max-w-xl text-muted">
            I take on a small number of projects: APIs and services, performance problems, AWS and CI/CD setup, and legacy modernization.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a href="/hire" class="btn btn-primary">How I can help <Icon name="arrow-right" size={16} /></a>
          <a href={`mailto:${profile.email}?subject=Project%20inquiry`} class="btn btn-ghost"><Icon name="mail" size={16} /> Email me</a>
        </div>
      </div>
    </div>
  </section>
</Base>
